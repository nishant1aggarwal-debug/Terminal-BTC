# =============================================================================
# Terminal-BTC — defaults are PAPER + rules-based. No API keys required to run.
# =============================================================================

# ---- Safety flags (start here) ----
# PAPER_MODE=true  -> no real orders ever; uses real Binance PUBLIC market data.
# To ever hit a real exchange you must set PAPER_MODE=false AND LIVE_TRADING=true
# AND (for live, not testnet) BINANCE_TESTNET=false.
PAPER_MODE=true
LIVE_TRADING=false

# ---- Signal generator ----
# "rules"  -> local EMA/RSI/MACD engine, no keys needed (default).
# "claude" -> Anthropic Claude. Requires ANTHROPIC_API_KEY below.
# "hold"   -> always hold (for pipeline smoke tests).
SIGNAL_MODE=rules

# ---- Paper trading ----
PAPER_STARTING_EQUITY_USDT=1000

# ---- Trading params ----
TRADE_SYMBOL=BTC/USDT
TRADE_MARKET=spot
TRADE_TIMEFRAME=15m
POLL_INTERVAL_SEC=300

# ---- Risk caps (applied in both paper and live) ----
MAX_POSITION_USDT=50
MAX_DAILY_LOSS_USDT=25
MAX_OPEN_POSITIONS=1
SYMBOL_ALLOWLIST=BTC/USDT,ETH/USDT

# ---- TradingView webhook (optional; free TV tier has no webhooks) ----
TRADINGVIEW_WEBHOOK_SECRET=change-me

# ---- Anthropic / Claude (optional — only required when SIGNAL_MODE=claude) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_MAX_TOKENS=1024
DAILY_CLAUDE_USD_CAP=5

# ---- Binance (optional — only required when PAPER_MODE=false) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ---- Infra ----
DATABASE_URL=sqlite:///data/terminal_btc.db
LOG_LEVEL=INFO
