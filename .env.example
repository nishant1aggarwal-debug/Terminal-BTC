# =============================================================================
# Terminal-BTC — defaults are PAPER + rules-based + Bybit public data.
# No API keys required to run.
# =============================================================================

# ---- Safety flags (start here) ----
# PAPER_MODE=true  -> no real orders ever; uses real public market data.
# To ever hit a real exchange you must set PAPER_MODE=false AND LIVE_TRADING=true
# AND (for live Binance mainnet) BINANCE_TESTNET=false.
PAPER_MODE=true
LIVE_TRADING=false

# ---- Signal generator ----
# "rules"  -> local EMA/RSI/MACD engine, no keys needed (default).
# "claude" -> Anthropic Claude. Requires ANTHROPIC_API_KEY below.
# "hold"   -> always hold (for pipeline smoke tests).
SIGNAL_MODE=rules

# ---- Public market-data source (no keys required) ----
# "bybit"   -> default; globally accessible public endpoints.
# "binance" -> largest liquidity but geo-blocked in some regions (US, UK, etc.).
# "kraken"  -> good fallback where Binance/Bybit are blocked.
DATA_SOURCE=bybit

# ---- Paper trading ----
PAPER_STARTING_EQUITY_USDT=5000
# Per-trade risk budget (fraction of equity risked via stop-loss distance).
RISK_PER_TRADE_PCT=0.01

# ---- Realistic paper fees (match Binance taker rates) ----
FEE_SPOT_BPS=10       # 0.10%  spot taker
FEE_FUTURES_BPS=4     # 0.04%  USDⓈ-M futures taker
SLIPPAGE_BPS=2        # 0.02%  adverse fill on market orders
FUNDING_RATE_8H_BPS=1 # 0.01%  funding every 8h (futures only)

# ---- Futures controls (ignored when TRADE_MARKET=spot) ----
MARGIN_MODE=isolated  # cross | isolated
LEVERAGE=10           # Bybit-futures-style default; max 125x on Binance futures

# ---- Trading universe (34 high-volume USDT pairs, alt-heavy) ----
# Alts have 2-5x the beta of BTC/ETH, so capturing their amplified moves
# during macro trends is where the strategy earns. Grouped by sector:
#   Majors: BTC/ETH/SOL/XRP
#   Top-10 alts: DOGE/ADA/AVAX/LINK/BNB/TON/TRX/LTC
#   L1/L2: DOT/MATIC/NEAR/APT/ATOM/FIL/HBAR/ARB/OP/SUI/SEI/INJ/TIA
#   DeFi: UNI/AAVE/MKR/CRV/LDO
#   Legacy: XLM/ALGO/XTZ/ETC
#   Gaming/metaverse: SAND/MANA/AXS
TRADE_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,AVAX/USDT,LINK/USDT,BNB/USDT,TON/USDT,TRX/USDT,LTC/USDT,DOT/USDT,MATIC/USDT,NEAR/USDT,APT/USDT,ATOM/USDT,FIL/USDT,HBAR/USDT,ARB/USDT,OP/USDT,SUI/USDT,SEI/USDT,INJ/USDT,TIA/USDT,UNI/USDT,AAVE/USDT,MKR/USDT,CRV/USDT,LDO/USDT,XLM/USDT,ALGO/USDT,XTZ/USDT,ETC/USDT,SAND/USDT,MANA/USDT,AXS/USDT
TRADE_MARKET=futures   # spot | futures (Bybit USDⓈ-M perps)
TRADE_TIMEFRAME=15m
POLL_INTERVAL_SEC=300

# ---- Risk caps (apply in both paper and live) ----
# Bybit-futures-style: 8 concurrent positions, $500 max notional each, 10x leverage.
MAX_POSITION_USDT=500
MAX_DAILY_LOSS_USDT=250
MAX_OPEN_POSITIONS=8
# Composite signal score threshold — lower fires more trades, higher is stricter.
MIN_SIGNAL_CONFIDENCE=0.55
# Hard filter — anything outside this list is refused even if TradingView sends it.
# Superset of TRADE_SYMBOLS + meme/retail pairs (SHIB/PEPE/WIF/BONK/FLOKI/JUP/PYTH/JTO/ORDI)
# and extra DeFi/gaming/infra pairs. ~55 pairs total.
SYMBOL_ALLOWLIST=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,AVAX/USDT,LINK/USDT,BNB/USDT,TON/USDT,TRX/USDT,LTC/USDT,DOT/USDT,MATIC/USDT,NEAR/USDT,APT/USDT,ATOM/USDT,FIL/USDT,HBAR/USDT,ARB/USDT,OP/USDT,SUI/USDT,SEI/USDT,INJ/USDT,TIA/USDT,UNI/USDT,AAVE/USDT,MKR/USDT,CRV/USDT,LDO/USDT,COMP/USDT,SNX/USDT,XLM/USDT,ALGO/USDT,XTZ/USDT,ETC/USDT,ICP/USDT,FLOW/USDT,KSM/USDT,EGLD/USDT,SAND/USDT,MANA/USDT,AXS/USDT,IMX/USDT,GALA/USDT,APE/USDT,CHZ/USDT,RUNE/USDT,GRT/USDT,RNDR/USDT,FET/USDT,THETA/USDT,SHIB/USDT,PEPE/USDT,WIF/USDT,BONK/USDT,FLOKI/USDT,JUP/USDT,PYTH/USDT,JTO/USDT,ORDI/USDT

# ---- TradingView webhook (optional; free TV tier has no webhooks) ----
TRADINGVIEW_WEBHOOK_SECRET=change-me

# ---- Anthropic / Claude (optional — only required when SIGNAL_MODE=claude) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_MAX_TOKENS=1024
DAILY_CLAUDE_USD_CAP=5

# ---- Binance (optional — only required when PAPER_MODE=false & executing on Binance) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ---- Infra ----
DATABASE_URL=sqlite:///data/terminal_btc.db
LOG_LEVEL=INFO
